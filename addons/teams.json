{
  "id": "teams",
  "name": "Microsoft Teams",
  "version": 1,
  "icon": "people",
  "description": "Mute, camera, screen sharing, raise hand and leave in meetings, and getting around Teams.",
  "apps": {
    "mac": [
      "com.microsoft.teams2",
      "com.microsoft.teams"
    ],
    "win": [
      "ms-teams.exe",
      "teams.exe"
    ]
  },
  "shortcuts": [
    {
      "id": "mute",
      "label": "Mute / unmute",
      "icon": "mic",
      "section": "Meetings",
      "mac": "Cmd+Shift+M",
      "win": "Ctrl+Shift+M"
    },
    {
      "id": "video",
      "label": "Camera on / off",
      "icon": "camera",
      "section": "Meetings",
      "mac": "Cmd+Shift+O",
      "win": "Ctrl+Shift+O"
    },
    {
      "id": "share",
      "label": "Share screen",
      "icon": "share",
      "section": "Meetings",
      "mac": "Cmd+Shift+E",
      "win": "Ctrl+Shift+E"
    },
    {
      "id": "hand",
      "label": "Raise / lower hand",
      "icon": "hand",
      "section": "Meetings",
      "mac": "Cmd+Shift+K",
      "win": "Ctrl+Shift+K"
    },
    {
      "id": "blur",
      "label": "Blur background",
      "icon": "person",
      "section": "Meetings",
      "mac": "Cmd+Shift+P",
      "win": "Ctrl+Shift+P"
    },
    {
      "id": "leave",
