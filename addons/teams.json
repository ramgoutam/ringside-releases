      "win": "Ctrl+2"
    },
    {
      "id": "teams",
      "label": "Teams",
      "icon": "people",
      "section": "Go to",
      "mac": "Cmd+3",
      "win": "Ctrl+3"
    },
    {
      "id": "calendar",
      "label": "Calendar",
      "icon": "history",
      "section": "Go to",
