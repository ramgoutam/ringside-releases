      "icon": "camera",
      "section": "Calls",
      "mac": "Cmd+Shift+A",
      "win": "Ctrl+Shift+A"
    },
    {
      "id": "accept-audio",
      "label": "Answer with audio",
      "icon": "mic",
      "section": "Calls",
      "mac": "Cmd+Shift+S",
      "win": "Ctrl+Shift+S"
    },
    {
