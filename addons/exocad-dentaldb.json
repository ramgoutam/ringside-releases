    {
      "id": "open",
      "label": "Load a project",
      "icon": "folder",
      "section": "Projects",
      "win": "Ctrl+L"
    },
    {
      "id": "save",
      "label": "Save",
      "icon": "check",
      "section": "Projects",
      "win": "Ctrl+S"
    },
    {
      "id": "duplicate",
      "label": "Duplicate project",
      "icon": "copy",
      "section": "Projects",
      "win": "Ctrl+D"
    }
  ],
  "ring": [
    "new",
    "open",
    "save",
    "duplicate"
  ]
}
