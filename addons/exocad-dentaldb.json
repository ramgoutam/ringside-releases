{
  "id": "exocad-dentaldb",
  "name": "exocad DentalDB",
  "version": 1,
  "icon": "tooth",
  "description": "New, open, save and duplicate projects in exocad DentalDB.",
  "apps": {
    "mac": [],
    "win": [
      "dentaldb.exe",
      "dentaldbapp.exe"
    ]
  },
  "shortcuts": [
    {
      "id": "new",
      "label": "New project",
      "icon": "plus",
