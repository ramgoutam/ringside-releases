{
  "id": "chrome",
  "name": "Google Chrome",
  "version": 1,
  "description": "Tabs, windows, history, bookmarks, zoom and developer tools in Chrome.",
  "apps": { "mac": ["com.google.Chrome"], "win": ["chrome.exe"] },
  "shortcuts": [
    { "id": "new-tab", "label": "New tab", "icon": "newtab", "section": "Tabs", "mac": "Cmd+T", "win": "Ctrl+T" },
    { "id": "reopen-tab", "label": "Reopen closed tab", "icon": "reopen", "section": "Tabs", "mac": "Cmd+Shift+T", "win": "Ctrl+Shift+T" },
    { "id": "close-tab", "label": "Close tab", "icon": "close", "section": "Tabs", "mac": "Cmd+W", "win": "Ctrl+W" },
    { "id": "next-tab", "label": "Next tab", "icon": "forward", "section": "Tabs", "mac": "Alt+Cmd+Right", "win": "Ctrl+Tab" },
    { "id": "previous-tab", "label": "Previous tab", "icon": "back", "section": "Tabs", "mac": "Alt+Cmd+Left", "win": "Ctrl+Shift+Tab" },
    { "id": "last-tab", "label": "Last tab", "icon": "arrowRight", "section": "Tabs", "mac": "Cmd+9", "win": "Ctrl+9" },
    { "id": "search-tabs", "label": "Search tabs", "icon": "search", "section": "Tabs", "mac": "Cmd+Shift+A", "win": "Ctrl+Shift+A" },
    { "id": "new-window", "label": "New window", "icon": "newtab", "section": "Windows", "mac": "Cmd+N", "win": "Ctrl+N" },
    { "id": "incognito", "label": "New incognito window", "icon": "incognito", "section": "Windows", "mac": "Cmd+Shift+N", "win": "Ctrl+Shift+N" },
    { "id": "close-window", "label": "Close window", "icon": "close", "section": "Windows", "mac": "Cmd+Shift+W", "win": "Ctrl+Shift+W" },
    { "id": "full-screen", "label": "Full screen", "icon": "maximize", "section": "Windows", "mac": "Ctrl+Cmd+F", "win": "F11" },
    { "id": "back", "label": "Back", "icon": "back", "section": "Page", "mac": "Cmd+[", "win": "Alt+Left" },
    { "id": "forward", "label": "Forward", "icon": "forward", "section": "Page", "mac": "Cmd+]", "win": "Alt+Right" },
    { "id": "reload", "label": "Reload", "icon": "reload", "section": "Page", "mac": "Cmd+R", "win": "Ctrl+R" },
    { "id": "hard-reload", "label": "Reload without cache", "icon": "reload", "section": "Page", "mac": "Cmd+Shift+R", "win": "Ctrl+Shift+R" },
    { "id": "home", "label": "Home page", "icon": "home", "section": "Page", "mac": "Cmd+Shift+H", "win": "Alt+Home" },
    { "id": "address", "label": "Address bar", "icon": "globe", "section": "Page", "mac": "Cmd+L", "win": "Ctrl+L" },
    { "id": "find", "label": "Find on page", "icon": "search", "section": "Page", "mac": "Cmd+F", "win": "Ctrl+F" },
    { "id": "print", "label": "Print", "icon": "print", "section": "Page", "mac": "Cmd+P", "win": "Ctrl+P" },
    { "id": "save", "label": "Save page", "icon": "download", "section": "Page", "mac": "Cmd+S", "win": "Ctrl+S" },
    { "id": "zoom-in", "label": "Zoom in", "icon": "zoomIn", "section": "Zoom", "mac": "Cmd+=", "win": "Ctrl+=" },
    { "id": "zoom-out", "label": "Zoom out", "icon": "zoomOut", "section": "Zoom", "mac": "Cmd+-", "win": "Ctrl+-" },
    { "id": "zoom-reset", "label": "Actual size", "icon": "search", "section": "Zoom", "mac": "Cmd+0", "win": "Ctrl+0" },
    { "id": "bookmark", "label": "Bookmark this page", "icon": "bookmark", "section": "Bookmarks & history", "mac": "Cmd+D", "win": "Ctrl+D" },
    { "id": "bookmarks-bar", "label": "Bookmarks bar", "icon": "star", "section": "Bookmarks & history", "mac": "Cmd+Shift+B", "win": "Ctrl+Shift+B" },
    { "id": "bookmarks", "label": "Bookmark manager", "icon": "bookmark", "section": "Bookmarks & history", "mac": "Alt+Cmd+B", "win": "Ctrl+Shift+O" },
    { "id": "history", "label": "History", "icon": "history", "section": "Bookmarks & history", "mac": "Cmd+Y", "win": "Ctrl+H" },
    { "id": "downloads", "label": "Downloads", "icon": "download", "section": "Bookmarks & history", "mac": "Alt+Cmd+L", "win": "Ctrl+J" },
    { "id": "clear-data", "label": "Clear browsing data", "icon": "close", "section": "Bookmarks & history", "mac": "Cmd+Shift+Delete", "win": "Ctrl+Shift+Delete" },
    { "id": "devtools", "label": "Developer tools", "icon": "code", "section": "Developer", "mac": "Alt+Cmd+I", "win": "Ctrl+Shift+I" },
    { "id": "console", "label": "JavaScript console", "icon": "terminal", "section": "Developer", "mac": "Alt+Cmd+J", "win": "Ctrl+Shift+J" },
    { "id": "view-source", "label": "View source", "icon": "code", "section": "Developer", "mac": "Alt+Cmd+U", "win": "Ctrl+U" },
    { "id": "task-manager", "label": "Task manager", "icon": "apps", "section": "Developer", "win": "Shift+Escape" },
    { "id": "settings", "label": "Settings", "icon": "sliders", "section": "Developer", "mac": "Cmd+," },
    { "id": "menu", "label": "Chrome menu", "icon": "sliders", "section": "Developer", "win": "Alt+F" }
  ],
  "ring": [
    "new-tab",
    "forward",
    "reload",
    { "group": "Tabs", "icon": "stack", "items": ["next-tab", "previous-tab", "search-tabs", "new-window", "incognito"] },
    "close-tab",
    { "group": "History", "icon": "history", "items": ["history", "downloads", "bookmark", "bookmarks"] },
    "back",
    "reopen-tab"
  ]
}
